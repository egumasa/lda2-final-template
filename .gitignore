# Secrets — never commit. Your Gemini API key lives here.
.env

# Run outputs (regenerated every run). These are also the files you submit —
# scripts/make_submission.py collects them for you.
outputs/*
!outputs/.gitkeep

# ---------------------------------------------------------------------------
# Data — three rules, in order of increasing specificity.
# ---------------------------------------------------------------------------
# 1. No pool data is committed. Builder inputs (data/raw/) and every pool you
#    build (data/pools/, demo pools included) stay local: they are large, and
#    most of them are not ours to redistribute. Build them with
#        python scripts/prep_datasets.py <track> --demos
#    or by running notebooks/01_build_pool_<track>.ipynb.
data/raw/*
!data/raw/.gitkeep
data/pools/*
!data/pools/.gitkeep
!data/pools/README.md
!data/pools/LICENSE

# 2. data/gold/ is now entirely YOUR work - the sample notebook 02 draws and the
#    adjudicated gold set notebook 03 writes. None of it is committed: it is yours,
#    and it goes in the submission bundle rather than into git.
data/gold/*
!data/gold/.gitkeep
!data/gold/README.md

# 3. ICNALE GRA is research-use-only and must NOT be redistributed. This rule comes
#    LAST so it overrides every exception above, whatever the file ends up called.
#    It is scoped to data/ so that the ICNALE *prompt* and *pool-building notebook* —
#    which are code, not data — can still be tracked.
data/**/*icnale*
data/**/*ICNALE*

# Notebook / Python cruft
.ipynb_checkpoints/
__pycache__/
*.pyc
*.executed.ipynb

# Notebooks 01-05 ARE tracked, blanks and all - the Colab badges in the README
# point at them on GitHub, and a group's filled-in copies live in their own Drive.
# Anything a group renames for itself stays local.
notebooks/*_working.ipynb
notebooks/Copy of *.ipynb

# Design notes and specs for this repository's own build tooling. Working material
# that records why the scaffold is shaped the way it is; it is not needed to run the
# project, and it changes independently of the code, so it stays local.
docs/

# macOS
.DS_Store

# uv virtual environment (recreate with `uv sync`)
.venv/
