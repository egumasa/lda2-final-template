# Copy this file to a new file literally named `.env` (with the leading dot) and fill in
# your key. `.env` is git-ignored — never commit it.
#
# You only need this when running LOCALLY (not in Google Colab — Colab has a free
# built-in Gemini backend). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: pin a specific model (defaults to gemini-2.5-flash).
# LLM_MODEL=gemini-2.5-flash
